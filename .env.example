# Spotify API credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8642/api/spotify/callback

# Google OAuth (optional, for YouTube watch history)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8642/api/youtube/oauth/callback

# Qobuz (FLAC, Studio/Sublime plan). Sign in from the Qobuz card on Home: the login is kept in
# data/qobuz_session.json, never here. Downloads try Qobuz first for "Best" and "FLAC only".
# QOBUZ_MAX_FORMAT=27               # 27 = up to 24-bit/192 kHz, 7 = up to 24/96, 6 = 16/44.1
# QOBUZ_MAX_DOWNLOADS_PER_DAY=100   # Qobuz streams per day (Download all 60%, FLAC upgrades 20% of it);
#                                   # counter in data/qobuz_daily.json, log in data/qobuz_events.jsonl
# QOBUZ_API_CALLS_PER_MINUTE=20     # shared by all workers; keep well under 60
# QOBUZ_CHECK_QUERY=Miles Davis So What
# QOBUZ_UPGRADE_KEEP_DAYS=30        # old files of a FLAC upgrade stay in data/upgrades/ for Revert
# ALLOWED_HOSTS=["127.0.0.1","localhost"]   # Host names the server answers (DNS-rebinding guard)

# Browser to pull YouTube Music cookies from (chrome | firefox | edge | brave).
# On native Windows, Chrome may block extraction (app-bound encryption) — try firefox.
# COOKIE_BROWSER=chrome

# Netscape cookies.txt used for YouTube Music Premium downloads. Default: DATA_DIR/cookies.txt.
# This file is your Google session -- keep it private and out of any synced folder.
# COOKIE_FILE=./data/cookies.txt

# Track the "Premium check" probes on music.youtube.com. It must be public there; if it is
# ever taken down the check falls back to a second known-public track on its own.
# PREMIUM_CHECK_VIDEO_ID=dQw4w9WgXcQ

# App settings
LIBRARY_DIR=./library
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
# native (Qobuz FLAC first, else the YouTube AAC/Opus stream) | mp3 (YouTube, transcoded to 320; skips Qobuz)
# | flac_lossless (Qobuz only; fails instead of falling back)
DEFAULT_FORMAT=mp3

# ID3v2 minor version written to MP3 files: 3 = ID3v2.3, the safer choice for embedded
# players like the H2; 4 = ID3v2.4 (what Leasure wrote before).
# ID3_VERSION=3

# Ceiling on authenticated YouTube downloads per day, to keep the session below
# anything YouTube reads as abuse. Counter lives in DATA_DIR/yt_daily.json.
YT_MAX_DOWNLOADS_PER_DAY=50

# Album pages fill in the songs you don't have from MusicBrainz, then Deezer (no account),
# looked up once per album in the background. false = library data only, no lookups.
# ALBUM_INFO_LOOKUPS=true

# Read your Qobuz favorites and YouTube Music library every 12 h, and Spotify once a day after
# its first read, for the Saved tab. false = only what is already stored.
# SAVED_SYNC_ENABLED=true

HOST=127.0.0.1
PORT=8642
