# Spotify API credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8642/api/spotify/callback

# Google OAuth (optional, for YouTube watch history)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8642/api/youtube/oauth/callback

# Optional: Lossless service credentials
# QOBUZ_EMAIL=
# QOBUZ_PASSWORD=
# TIDAL_EMAIL=
# TIDAL_PASSWORD=
# DEEZER_ARL=

# Browser to pull YouTube Music cookies from (chrome | firefox | edge | brave).
# On native Windows, Chrome may block extraction (app-bound encryption) — try firefox.
# COOKIE_BROWSER=chrome

# App settings
LIBRARY_DIR=./library
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
DEFAULT_FORMAT=mp3
HOST=127.0.0.1
PORT=8642
