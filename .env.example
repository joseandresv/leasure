# Spotify API credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8642/api/spotify/callback

# Google OAuth (optional, for YouTube watch history)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8642/api/youtube/oauth/callback

# Optional: Lossless service credentials
# QOBUZ_EMAIL=
# QOBUZ_PASSWORD=
# TIDAL_EMAIL=
# TIDAL_PASSWORD=
# DEEZER_ARL=

# Browser to pull YouTube Music cookies from (chrome | firefox | edge | brave).
# On native Windows, Chrome may block extraction (app-bound encryption) — try firefox.
# COOKIE_BROWSER=chrome

# Netscape cookies.txt used for YouTube Music Premium downloads. Default: DATA_DIR/cookies.txt.
# This file is your Google session -- keep it private and out of any synced folder.
# COOKIE_FILE=./data/cookies.txt

# Track the "Premium check" probes on music.youtube.com.
# PREMIUM_CHECK_VIDEO_ID=XclachpHxis

# App settings
LIBRARY_DIR=./library
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
# native (keep the source AAC/Opus) | mp3 (transcode to 320) | flac_lossless (needs a lossless service)
DEFAULT_FORMAT=mp3

# Ceiling on authenticated YouTube downloads per day, to keep the session below
# anything YouTube reads as abuse. Counter lives in DATA_DIR/yt_daily.json.
YT_MAX_DOWNLOADS_PER_DAY=50

HOST=127.0.0.1
PORT=8642
